# Student-facing AI is deliberately disabled by Meta's under-18 terms.
# No dynamic model selection, alternate LLM, or student-facing Muse API key.
# The private adult-only test harness loads muse_api_key from ~/.env,
# and requires MUSE_ADULT_REVIEW=YES after confirming 18+ status.
# Never put Contributor credentials in public Pages environment variables.
HOST=127.0.0.1
PORT=3001
# Development frontend origin. For npm run serve locally, change to http://127.0.0.1:3001.
APP_ORIGIN=http://127.0.0.1:5173
# Required (>=24 characters) for a public origin in production OR any non-loopback HOST.
# Students enter this deployment access token in Settings; it is never stored in localStorage.
APP_ACCESS_TOKEN=
# Optional stable cookie signing secret; otherwise a random one is generated at server start.
SESSION_SECRET=
# Per-process attempted provider calls/day (UTC); failed upstream calls also consume the cap.
AI_DAILY_LIMIT=100
# Optional server-side editorial addendum. Core corrections are in src/content/index.ts.
MEDICAL_EDITORIAL_NOTE=
